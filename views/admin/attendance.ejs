<!-- //write a code in html with input fields for username and password and a submit button and image in the center and align to center of the page and place them in a container which looks like a 3D -->
<!DOCTYPE html>
<html>
<head>
  <title>ACE | Login</title>
  
  <link rel="shortcut icon" href="/img/image.png" />
  <style type="text/css">
    body{ 
       margin: 0; 
       padding: 0; 
       width: 100%;
       background-color: #9193ac; 
     } 
     .navbar{ 
       width: 100%; 
       height: 60px; 
       background-color: #020202; 
       display: flex; 
       justify-content: space-between; 
       align-items: center; 
     } 
     .navbar a{ 
       text-decoration: none;
       color: white; 
       margin-left: 10px; 
     } 
    .container{
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 200px;
    }
    .box{
      width: 600px;
      height: 300px;
      background-color: #f1f1f1;
      border: 1px solid #ccc;
      border-radius: 10px;
      box-shadow: 5px 5px 5px #ccc;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    input[type="text"], input[type="password"]{
      width: 300px;
      height: 30px;
      border: 1px solid #ccc;
      border-radius: 5px;
      padding: 10px;
      margin-left: 10px;
    }
    textarea{

        width: 300px;
        height: 100px;
        border: 1px solid #ccc; 
        border-radius: 5px;
        padding: 10px;
        margin-left: 10px;
        rows: 4;

    }
    input[type="submit"]{
      width: 100px;
      height: 30px;
      border: 1px solid #ccc;
      border-radius: 5px;
      background-color: #9193ac;
      color: white;
      cursor: pointer;
    }
  </style>
</head>
<div class="navbar"> 
    <img src="/img/image.png" width="50px" height="50px">
 <a href="/dashboard">ADMIN</a> 
 <a style="margin-right: 10px;" href="/logout">Logout</a> 
</div> 
<body>
  <div class="container">
    <div class="box">
      <img src="/img/image.png" width="200px" height="200px"><br><br>
      <form action="/mail" method="post">
        <input type="text" name="sub" placeholder="Subject"><br><br>
        <textarea name="desc" placeholder="Message"></textarea><br><br>
        <center><input type="submit" value="Send mail"></center>
      </form>
    
    </div>
  </div>
</body>

</html>