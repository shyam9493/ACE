<!DOCTYPE html> 
<html>
<head> 
   <title>ACE | Dashboard</title>
   <link rel="shortcut icon" href="/img/image.png" /> 
   <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.24/css/jquery.dataTables.min.css">
   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
   <style type="text/css">
     body{ 
       margin: 0; 
       padding: 0; 
       width: 100%;
       background-color: #9193ac; 
     } 
     .navbar{ 
       width: 100%; 
       height: 60px; 
       background-color: #020202; 
       display: flex; 
       justify-content: space-between; 
       align-items: center; 
     } 
     .navbar a{ 
       text-decoration: none;
       color: white; 
       margin-left: 10px; 
     } 
     .container{ 
       width: 100%; 
       height: 100%; 
       display: flex; 
       justify-content: center; 
       align-items: center; 
       margin-top: 50px; 
     } 
     .box{ 
       width: 300px; 
       height: 150px; 
       background-color: #f1f1f1; 
       border: 1px solid #ccc; 
       border-radius: 10px; 
       box-shadow: 5px 5px 5px #ccc; 
       display: flex; 
       justify-content: center;
       align-items: center; 
       margin-right: 10px;
     } 
     .box div{ 
       width: 200px; 
       height: 200px; 
       margin: 10px; 
       border-radius: 10px; 
       display: flex; 
       justify-content: center; 
       align-items: center; 
     } 
     .box div a{ 
       text-decoration: none; 
       color: white; 
     } 
     table{ 
       margin-top: 50px; 
     }
   </style>
 </head> 
 <body> 
   <div class="navbar"> 
        <img src="/img/image.png" width="50px" height="50px">
     <a href="/dashboard">ADMIN</a> 
     <a style="margin-right: 10px;" href="/logout">Logout</a> 
   </div> 
   <% for(var i=0; i<5 ; i++){ %>
   <div class="container col-sm-12"> 
 
     <div class="box col-sm-3"> 
        <a href="/view"><div><img src="/img/image.png" width="100px" height="100px"></div> </a>
        <label>NAME</label>
        <label style="margin-right: 10px;">PERSON</label>

     </div> 
     <div class="box col-sm-3"> 
      <a href="/view"><div><img src="/img/image.png" width="100px" height="100px"></div> </a>
      <label>NAME</label>
        <label style="margin-right: 10px;">PERSON</label>
   </div> 
   <div class="box col-sm-3"> 
    <a href="/view"><div><img src="/img/image.png" width="100px" height="100px"></div> </a>
    <label>NAME</label>
        <label style="margin-right: 10px;">PERSON</label>
 </div> 
   </div>   
<% } %>

 
  
 </body>
 
 <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js" integrity="sha384-KJ3o2DKtIkvYIK3UENzmM7KCkRr/rE9/Qpg6aAZGJwFDMVNA/GpGFF93hXpG5KkN" crossorigin="anonymous"></script>
 <script src="https://cdn.jsdelivr.net/npm/popper.js@1.12.9/dist/umd/popper.min.js" integrity="sha384-ApNbgh9B+Y1QKtv3Rn7W3mgPxhU9K/ScQsAP7hUibX39j7fakFPskvXusvfa0b4Q" crossorigin="anonymous"></script>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/js/bootstrap.min.js" integrity="sha384-JZR6Spejh4U02d8jOt6vLEHfe/JQGiRRSQQxSfFWpi1MquVdAyjUar5+76PVCmYl" crossorigin="anonymous"></script>

 </html>